# URL pública de la app (se usa para los redirect URIs de OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Opcional: modelo usado para la auditoría de marca
ANTHROPIC_MODEL=claude-opus-5-5

# Meta / Instagram API con Instagram Login (App Dashboard → Instagram → API setup)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# 32 bytes en base64 para cifrar tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Secreto para firmar los enlaces de aprobación por email: openssl rand -base64 32
APPROVAL_LINK_SECRET=

# --- Fase 2: video (opcionales) ---
# Clips de stock verticales: https://www.pexels.com/api/ (gratis)
PEXELS_API_KEY=
# Voz en off: https://elevenlabs.io → Profile → API key
ELEVENLABS_API_KEY=
# Opcional: id de la voz (por defecto, una voz multilingüe de la biblioteca)
ELEVENLABS_VOICE_ID=
# Opcional: navegador para Remotion (si no, Remotion descarga el suyo)
REMOTION_BROWSER_EXECUTABLE=

# --- Fase 3: emails de aprobación (opcionales; sin ellos el enlace se escribe en el log) ---
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Auto-Publicator <reels@tudominio.com>"
EMAIL_FROM=

# --- Fase 4: worker y scheduler (opcionales) ---
# Tipos de trabajo de este worker (por defecto todos). Ej.: un worker solo para publicar:
# WORKER_KINDS=publish_reel
WORKER_KINDS=
# Cada cuánto busca reels aprobados cuya hora llegó (ms, por defecto 30000)
SCHEDULER_MS=

# --- Fase 5: webhooks de comentarios y DMs ---
# Texto secreto que inventas tú y pegas en Meta → Webhooks → Verify token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --- Fase 6: pagos con Stripe (opcionales; sin ellos la página de plan muestra "no configurado") ---
# Dashboard de Stripe → Developers → API keys (usa sk_test_… para pruebas)
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint {APP_URL}/api/webhooks/stripe → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# IDs de precio mensuales (price_…) de cada plan
STRIPE_PRICE_SELF_SERVE=
STRIPE_PRICE_DONE_FOR_YOU=
# Cada cuánto el worker encola métricas e informes semanales (ms, por defecto 15 min)
PERIODIC_MS=
